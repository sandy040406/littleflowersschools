# ============================================================
# Little Flowers Schools — Backend Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# "development" locally. Set to "production" on the live server:
# production refuses to start with a weak SECRET_KEY / default admin
# password, hides /docs, and enables HSTS.
ENVIRONMENT=development

# Database
# For local SQLite (development):
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/littleflowers

# JWT Authentication
# Production: at least 32 random characters, e.g. generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin account (created on first run)
# Production: use a strong password of at least 10 characters.
ADMIN_EMAIL=admin@littleflowersschools.com
ADMIN_PASSWORD=admin123

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Cloudflare R2 (fill in later)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# CORS — allowed frontend origin(s)
# Production example: FRONTEND_URL=https://www.littleflowersschools.com
FRONTEND_URL=http://localhost:3000
# Extra origins, comma-separated (e.g. the bare domain as well as www):
# CORS_ORIGINS=https://littleflowersschools.com

# Rate limiting
# Set to true ONLY behind a reverse proxy such as Render, so each visitor
# is counted by their real IP instead of the proxy's.
TRUST_PROXY_HEADERS=false
# ENQUIRY_RATE_LIMIT=10
# ENQUIRY_RATE_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT=30
# LOGIN_RATE_WINDOW_SECONDS=300
