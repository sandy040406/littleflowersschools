# ============================================================
# Little Flowers Schools — Backend Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Database
# For local SQLite (development):
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/littleflowers

# JWT Authentication
SECRET_KEY=change-me-to-a-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin account (created on first run)
ADMIN_EMAIL=admin@littleflowersschools.com
ADMIN_PASSWORD=admin123

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Cloudflare R2 (fill in later)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# CORS — allowed frontend origin
FRONTEND_URL=http://localhost:3000
